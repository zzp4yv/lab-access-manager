# Copie este arquivo para `.env` e preencha com os valores reais do
# ambiente do Instituto Oxigênio antes de subir em produção.

# --- Aplicação -------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- Banco de dados (SQLite) -----------------------------------------
DATABASE_URL=sqlite:////app/data/lab_access.db

# --- Autenticação / JWT -----------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-este-valor-por-um-segredo-forte-e-unico
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Admin inicial (criado automaticamente no primeiro start) ----------
BOOTSTRAP_ADMIN_NAME="Administrador Oxigenio"
BOOTSTRAP_ADMIN_EMAIL=laboratorio@oxigenioaceleradora.com.br
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-antes-do-primeiro-login

# --- Upload de documentos ---------------------------------------------
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,png,jpg,jpeg,txt

# --- Regras de ciclo de vida de acesso ---------------------------------
DEFAULT_ACCESS_DAYS=30
MAX_ACCESS_DAYS=365
DATA_RETENTION_DAYS_AFTER_REVOKE=30
LIFECYCLE_CHECK_INTERVAL_MINUTES=60

# --- Infraestrutura do laboratório -------------------------------------
# Nomes/IPs resolvíveis via VPN/rede interna das máquinas Dell DGX GB10.
LINUX_HOSTS=tars,case
LINUX_SSH_PORT=22
LINUX_SSH_ADMIN_USER=labadmin
LINUX_SSH_PRIVATE_KEY_PATH=/app/secrets/id_ed25519_provisioning
LINUX_DEFAULT_GROUP=lab-visitantes
LINUX_HOME_BASE=/home

# Caminhos montados no docker-compose (chave privada dedicada à
# automação e known_hosts com as chaves reais de tars/case).
SSH_PROVISIONING_KEY_PATH=./secrets/id_ed25519_provisioning
SSH_KNOWN_HOSTS_PATH=./secrets/known_hosts

# --- Pangolin (VPN) ----------------------------------------------------
PANGOLIN_API_URL=https://pangolin.internal.oxigenio/api
PANGOLIN_API_TOKEN=
PANGOLIN_ORG_ID=
PANGOLIN_SITE_ID=

# --- Next Term (shell + RDP) --------------------------------------------
NEXT_TERM_API_URL=https://nextterm.internal.oxigenio/api
NEXT_TERM_API_TOKEN=

# --- Modo de operação dos adaptadores -----------------------------------
# dry_run (padrão seguro, apenas loga) | live (executa contra a infra real)
PROVISIONING_MODE=dry_run

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=*

# --- Porta exposta no host (docker-compose) ------------------------------
HOST_PORT=8000
IMAGE_NAME=lab-access-manager
IMAGE_TAG=latest
